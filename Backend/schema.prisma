datasource db {
  provider = "postgresql"
  url      = "postgresql://exampleuser:examplepass@localhost:5432/exampledb?schema=public"
}

generator client {
  provider = "prisma-client-js"
}

enum ChannelTypes {
  PRIVATE
  PUBLIC
  DM
}

model Server {
  id         Int       @id @unique @default(autoincrement())
  name       String    @unique
  channels   Channel[]
  moderators User[]    @relation("Moderators")
  members    User[]    @relation("Members")
}

model User {
  id              Int       @id @default(autoincrement())
  firstName       String    
  lastName        String    
  userName        String    @unique
  email           String    @unique
  password        String
  avatar          String?
  servers         Server[]  @relation("Members")
  moderator       Server[]  @relation("Moderators")
  privateChannels Channel[]
  messages        Message[]

  friended   Friends[] @relation("FrienderRelation")
  friendedBy Friends[] @relation("FriendedRelation")
}

model Friends {
  frienderId Int
  friendedId Int

  friender User @relation("FrienderRelation", fields: [frienderId], references: [id])
  friended User @relation("FriendedRelation", fields: [friendedId], references: [id])

  @@id([frienderId, friendedId])
}

model Channel {
  id       Int          @id @unique @default(autoincrement())
  name     String?
  type     ChannelTypes
  server   Server?      @relation(fields: [serverId], references: [id])
  messages Message[]

  privateMembers User[]

  serverId Int
}

model Message {
  id      Int      @id @unique @default(autoincrement())
  message String
  date    DateTime

  sender  User     @relation(fields: [userId], references: [id])
  Channel Channel  @relation(fields: [channelId], references: [id])

  userId    Int
  channelId Int
}
